{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Textile Waste app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run sensor simulator",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/smart-bin/simulator.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost",
      "url": "http://127.0.0.1:5000",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "App + Chrome",
      "configurations": ["Run Textile Waste app", "Launch Chrome against localhost"]
    },
    {
      "name": "App + Simulator + Chrome",
      "configurations": ["Run Textile Waste app", "Run sensor simulator", "Launch Chrome against localhost"]
    }
  ]
}
